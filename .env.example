# ============================================================
# BGVerify.ai — Production Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all values marked with <CHANGE_ME>
#   3. NEVER commit .env to git — it is in .gitignore
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_PORT=80
VITE_API_URL=/api/v1

# ── MongoDB ─────────────────────────────────────────────────
# Root credentials for the mongo container (used only for init)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<CHANGE_ME>

# ── JWT ─────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<CHANGE_ME>
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────────────
# Set to your actual domain in production
CORS_ORIGIN=http://localhost

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── BGCoin Pricing (in paise / smallest unit) ────────────────
BGCOIN_PRICE_100=9000
BGCOIN_PRICE_500=42500
BGCOIN_PRICE_1000=80000
